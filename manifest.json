{
  "schemaVersion": 1,
  "id": "milon-klei-kodesh",
  "name": "לשון הקודש",
  "version": "2.9.2",
  "stability": "beta",
  "author": "מילון כליקודש",
  "description": "מילון, שורשים, נרדפות ולועזיות; ניתוח משפט, ניקוד וטעמים, כללי הדקדוק וקונקורדנציה לתנ\"ך — פירוש לכל מילה מסומנת",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.98.3",
  "sdkVersion": "1.x",
  "icon": "icon/icon.png",
  "permissions": [
    "plugin.storage.read",
    "plugin.storage.write",
    "ui.feedback",
    "reader.open",
    "reader.context_menu",
    "plugin.open_other",
    "navigation.write",
    "app.startup_contributions",
    "app.run_on_startup",
    "app.background_keep_alive",
    "search.fulltext.read",
    "events.subscribe:theme.changed",
    "events.subscribe:reader.selection_changed",
    "reader.toolbar",
    "app.shortcuts",
    "network.localhost",
    "library.books.read",
    "library.content.read",
    "app.open_url",
    "app.info.read",
    "library.books.provide",
    "search.dialog",
    "tools.read",
    "search.field_actions"
  ],
  "contributes": {
    "toolTab": {
      "title": "לשון הקודש",
      "order": 310,
      "defaultPinned": true,
      "iconName": "book_open_24_regular"
    },
    "background": {
      "entrypoint": "background.html"
    },
    "startup": {
      "contextMenuItems": [
        {
          "id": "kk-lookup",
          "label": "פירוש וניתוח לשון הקודש",
          "icon": "book_open_24_regular",
          "openPlugin": true,
          "contexts": [
            "reader-selection",
            "reader-page-shape-selection"
          ]
        }
      ],
      "activationEvents": [
        "app.startup",
        "reader.selection_changed"
      ],
      "keepAlive": true,
      "toolbarItems": [
        {
          "id": "kk-toolbar",
          "title": "פירוש וניתוח לשון הקודש",
          "icon": "book_open_24_regular",
          "openPlugin": true
        }
      ],
      "shortcuts": [
        {
          "id": "kk-key",
          "label": "פירוש וניתוח לשון הקודש",
          "key": "ctrl+alt+m",
          "contextMenuItemId": "kk-lookup"
        }
      ],
      "libraryBooks": [
        {
          "id": "dikduk",
          "provider": "klikodesh-dikduk",
          "title": "ספרי דקדוק",
          "icon": "book_open_24_regular"
        }
      ],
      "searchDialogItems": [
        {
          "id": "kk-search",
          "type": "switch",
          "title": "חפש גם בלשון הקודש (מילון וספר הדקדוק)",
          "defaultValue": false,
          "persist": false,
          "openPluginOnSubmit": true,
          "resultsAction": "פירוש וניתוח בלשון הקודש",
          "visibleInModes": [
            "exact",
            "advanced"
          ]
        }
      ],
      "searchFieldActions": [
        {
          "id": "kk-field",
          "title": "פירוש המילה בלשון הקודש",
          "icon": "book_open_24_regular",
          "fields": [
            "fullText",
            "inBook"
          ],
          "visibleWhen": "nonEmptyText"
        },
        {
          "id": "kk-books",
          "title": "ספרי הדקדוק של לשון הקודש / ספרי הספרייה",
          "icon": "library_24_regular",
          "activeIcon": "library_24_filled",
          "libraryOnlyIcon": "book_24_regular",
          "mode": "providerBooksFilter"
        }
      ]
    }
  },
  "network": {
    "enabled": true,
    "allowlist": [
      "http://127.0.0.1:5000",
      "http://127.0.0.1:5001",
      "http://127.0.0.1:5002",
      "http://127.0.0.1:5003",
      "http://127.0.0.1:5004",
      "http://127.0.0.1:5005",
      "http://127.0.0.1:5006",
      "http://127.0.0.1:5007",
      "http://127.0.0.1:5008",
      "http://127.0.0.1:5009",
      "http://127.0.0.1:5010",
      "http://127.0.0.1:47917",
      "http://127.0.0.1:47918",
      "http://127.0.0.1:47919",
      "http://127.0.0.1:47920",
      "http://127.0.0.1:47921"
    ]
  }
}
