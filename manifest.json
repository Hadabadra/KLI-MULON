{
  "schemaVersion": 1,
  "id": "milon-klei-kodesh",
  "name": "לשון הקודש",
  "version": "1.8.2",
  "stability": "beta",
  "author": "מילון כליקודש",
  "description": "מילון לשון הקודש וקונקורדנציה לתנ\"ך: זיהוי מילה מסומנת וביטויים, שורשים ובניינים, רד\"ק וספר הבחור מהספרייה",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.98",
  "sdkVersion": "1.x",
  "icon": "icon/icon.png",
  "permissions": [
    "plugin.storage.read",
    "plugin.storage.write",
    "ui.feedback",
    "reader.open",
    "reader.context_menu",
    "plugin.open_other",
    "navigation.write",
    "app.startup_contributions",
    "app.run_on_startup",
    "app.background_keep_alive",
    "search.fulltext.read",
    "events.subscribe:theme.changed",
    "events.subscribe:reader.selection_changed",
    "reader.toolbar",
    "app.shortcuts",
    "network.localhost",
    "library.books.read",
    "app.open_url",
    "app.info.read",
    "library.books.provide",
    "search.dialog"
  ],
  "contributes": {
    "toolTab": {
      "title": "לשון הקודש",
      "order": 310,
      "defaultPinned": true,
      "iconName": "book_open_24_regular"
    },
    "background": {
      "entrypoint": "background.html"
    },
    "startup": {
      "contextMenuItems": [
        {
          "id": "kk-lookup",
          "label": "פתח בקונקורדנציה",
          "icon": "book_open_24_regular",
          "openPlugin": true,
          "contexts": [
            "reader-selection",
            "reader-page-shape-selection"
          ]
        }
      ],
      "activationEvents": [
        "app.startup",
        "reader.selection_changed"
      ],
      "keepAlive": true,
      "toolbarItems": [
        {
          "id": "kk-toolbar",
          "title": "קונקורדנציה",
          "icon": "book_open_24_regular",
          "openPlugin": true
        }
      ],
      "shortcuts": [
        {
          "id": "kk-key",
          "label": "פתח בקונקורדנציה",
          "key": "ctrl+alt+m",
          "contextMenuItemId": "kk-lookup"
        }
      ],
      "libraryBooks": [
        {
          "id": "dikduk",
          "provider": "klikodesh-dikduk",
          "title": "ספרי דקדוק",
          "icon": "book_open_24_regular"
        }
      ],
      "searchDialogItems": [
        {
          "id": "kk-search",
          "type": "checkbox",
          "title": "חפש גם בלשון הקודש (מילון וספר הדקדוק)",
          "defaultValue": false,
          "openPluginOnSubmit": true,
          "visibleInModes": [
            "exact",
            "advanced"
          ]
        }
      ]
    }
  },
  "network": {
    "enabled": true,
    "allowlist": [
      "http://127.0.0.1:5000",
      "http://127.0.0.1:5001",
      "http://127.0.0.1:5002",
      "http://127.0.0.1:5003",
      "http://127.0.0.1:5004",
      "http://127.0.0.1:5005",
      "http://127.0.0.1:5006",
      "http://127.0.0.1:5007",
      "http://127.0.0.1:5008",
      "http://127.0.0.1:5009",
      "http://127.0.0.1:5010"
    ]
  }
}